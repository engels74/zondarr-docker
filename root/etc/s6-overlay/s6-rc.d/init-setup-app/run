#!/command/with-contenv bash
# shellcheck shell=bash

# shellcheck source=/dev/null
source /etc/s6-overlay/scripts/bash-functions

set -e

umask "${UMASK}"

echo "
----------------------------------------------------------------------
ENVIRONMENT APP
----------------------------------------------------------------------
WEBUI_PORTS=${WEBUI_PORTS}
----------------------------------------------------------------------
"

# ── Data directory ──────────────────────────────────────────────────
mkdir -p "${CONFIG_DIR}/data"
find "${CONFIG_DIR}/data" \( ! -user hotio -or ! -group hotio \) -exec chown hotio:hotio {} +

# ── SECRET_KEY auto-generation ──────────────────────────────────────
if [[ -z "${SECRET_KEY}" ]]; then
    SECRET_KEY_FILE="${CONFIG_DIR}/data/.secret_key"
    if [[ -f "${SECRET_KEY_FILE}" ]]; then
        log_inf "Loading SECRET_KEY from ${SECRET_KEY_FILE}"
        SECRET_KEY=$(cat "${SECRET_KEY_FILE}")
    else
        log_inf "Generating new SECRET_KEY..."
        SECRET_KEY=$("${APP_DIR}/backend/.venv/bin/python" -c "import secrets; print(secrets.token_urlsafe(48))")
        echo "${SECRET_KEY}" > "${SECRET_KEY_FILE}"
        chmod 600 "${SECRET_KEY_FILE}"
    fi
    export SECRET_KEY
    printf '%s' "${SECRET_KEY}" > /var/run/s6/container_environment/SECRET_KEY
fi

# ── BOOTSTRAP_TOKEN auto-generation ───────────────────────────────────
if [[ -z "${BOOTSTRAP_TOKEN}" ]]; then
    BOOTSTRAP_TOKEN_FILE="${CONFIG_DIR}/data/.bootstrap_token"
    if [[ -f "${BOOTSTRAP_TOKEN_FILE}" ]]; then
        log_inf "Loading BOOTSTRAP_TOKEN from ${BOOTSTRAP_TOKEN_FILE}"
        BOOTSTRAP_TOKEN=$(cat "${BOOTSTRAP_TOKEN_FILE}")
    else
        log_inf "Generating new BOOTSTRAP_TOKEN..."
        BOOTSTRAP_TOKEN=$("${APP_DIR}/backend/.venv/bin/python" -c "import secrets; print(secrets.token_urlsafe(32))")
        echo "${BOOTSTRAP_TOKEN}" > "${BOOTSTRAP_TOKEN_FILE}"
        chmod 600 "${BOOTSTRAP_TOKEN_FILE}"
    fi
    export BOOTSTRAP_TOKEN
    printf '%s' "${BOOTSTRAP_TOKEN}" > /var/run/s6/container_environment/BOOTSTRAP_TOKEN
fi

# ── DATABASE_URL default (SQLite in /config/data/) ──────────────────
if [[ -z "${DATABASE_URL}" ]]; then
    DATABASE_URL="sqlite+aiosqlite:///${CONFIG_DIR}/data/zondarr.db"
    export DATABASE_URL
    printf '%s' "${DATABASE_URL}" > /var/run/s6/container_environment/DATABASE_URL
    log_inf "DATABASE_URL defaulting to SQLite at ${CONFIG_DIR}/data/zondarr.db"
fi

# ── API URL defaults ─────────────────────────────────────────────
# INTERNAL_API_URL: used by the SvelteKit server to reach the backend
# (server-side rendering and API proxy). Always localhost inside the container.
if [[ -z "${INTERNAL_API_URL}" ]]; then
    printf '%s' "http://localhost:8000" > /var/run/s6/container_environment/INTERNAL_API_URL
    log_inf "INTERNAL_API_URL defaulting to http://localhost:8000"
fi

# PUBLIC_API_URL: when empty, the frontend proxies /api/* requests through
# SvelteKit (same-origin, no CORS needed). Only set this if you need the
# browser to talk directly to the backend (requires CORS_ORIGINS too).
# Do NOT set a default here — empty enables the proxy.

# ── Alembic database migration ─────────────────────────────────────
log_inf "Running database migrations..."
cd "${APP_DIR}/backend" || exit 1
s6-setuidgid hotio "${APP_DIR}/backend/.venv/bin/python" -m alembic upgrade head
